{
  "schema": 4,
  "id": "_default",
  "name": "Default Pet Template",
  "scale": 0.5,
  "frame_width": 256,
  "frame_height": 256,
  "columns": 5,
  "default_animation": "idle",
  "animation_dir": "animations",
  "baseline_y": 224,
  "hitbox": {
    "x": 48,
    "y": 24,
    "w": 160,
    "h": 216
  },
  "motion": {
    "auto_roam_chance": 28,
    "min_idle_ms": 2600,
    "max_idle_ms": 7200,
    "walk_distance_threshold": 520,
    "screen_margin": 28
  },
  "interactions": {
    "left_click": {
      "animation": "happy",
      "duration_ms": 1200
    },
    "right_click": {
      "animation": "thinking",
      "duration_ms": 1800
    },
    "drag_start": {
      "random": [
        "cry",
        "angry",
        "scared",
        "dizzy"
      ],
      "duration_ms": 900
    },
    "drag_hold": {
      "random": [
        "cry",
        "angry",
        "scared",
        "dizzy"
      ],
      "interval_ms": 650
    },
    "drag_end": {
      "animation": "wave",
      "duration_ms": 900
    },
    "music_start": {
      "animation": "dance",
      "duration_ms": 3000
    }
  },
  "act_blacklist": [
    "source",
    "preview",
    "*_draft",
    "*_tmp",
    "walk_left",
    "walk_right",
    "run_left",
    "run_right"
  ],
  "unknown_animation_default": {
    "fps": 5,
    "kind": "action",
    "locomotion": false,
    "duration_ms": 1500,
    "description": "Auto-added animation discovered from animations/<act>.png. Tune this entry in the pet-specific pet.json when needed."
  },
  "animations": {
    "idle": {
      "file": "idle.png",
      "fps": 4,
      "kind": "state",
      "locomotion": false,
      "duration_ms": 2500,
      "description": "Idle standing animation with subtle blink/breathing."
    },
    "walk": {
      "file": "walk.png",
      "fps": 5,
      "kind": "move",
      "locomotion": true,
      "speed_px_s": 30,
      "native_facing": "right",
      "description": "Slow horizontal movement used while roaming."
    },
    "run": {
      "file": "run.png",
      "fps": 7,
      "kind": "move",
      "locomotion": true,
      "speed_px_s": 58,
      "native_facing": "right",
      "description": "Faster horizontal movement used for distant targets."
    },
    "happy": {
      "file": "happy.png",
      "fps": 5,
      "kind": "emotion",
      "locomotion": false,
      "duration_ms": 1500,
      "description": "Happy reaction. Stationary emotion."
    },
    "cry": {
      "file": "cry.png",
      "fps": 5,
      "kind": "emotion",
      "locomotion": false,
